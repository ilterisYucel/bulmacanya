{
  "name": "@bulmacanya/games",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bulmacanya oyun modülleri — FAZ-1: Shapetris. Shell kontratı IGameModule (packages/shared).",
  "exports": {
    "./shapetris": "./src/shapetris/index.ts",
    "./game7": "./src/game7/index.ts",
    "./game7/progression": "./src/game7/model/progression.ts",
    "./dusenin-dostu": "./src/dusenin-dostu/index.ts",
    "./dusenin-dostu/campaign": "./src/dusenin-dostu/model/campaign.ts"
  },
  "scripts": {
    "test": "bun test",
    "lint": "bun run scripts/check-purity.ts",
    "typecheck": "tsc --noEmit"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun test",
          "cwd": "apps/games"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun run scripts/check-purity.ts",
          "cwd": "apps/games"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "apps/games"
        }
      }
    }
  },
  "dependencies": {
    "@bulmacanya/game-fx": "workspace:*",
    "@bulmacanya/game-fx-pixi": "workspace:*",
    "@bulmacanya/shared": "workspace:*",
    "@pixi/react": "^8",
    "pixi.js": "^8.22.0",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5.8.0"
  }
}
