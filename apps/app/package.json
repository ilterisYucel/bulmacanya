{
  "name": "@bulmacanya/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "steiger ./src",
    "cap:sync": "cap sync",
    "cap:add:android": "cap add android"
  },
  "nx": {
    "targets": {
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "bun test",
          "cwd": "apps/app"
        }
      },
      "typecheck": {
        "executor": "nx:run-commands",
        "options": {
          "command": "tsc --noEmit",
          "cwd": "apps/app"
        }
      },
      "lint": {
        "executor": "nx:run-commands",
        "options": {
          "command": "steiger ./src",
          "cwd": "apps/app"
        }
      },
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "command": "vite build",
          "cwd": "apps/app"
        }
      }
    }
  },
  "dependencies": {
    "@bulmacanya/games": "workspace:*",
    "@bulmacanya/shared": "workspace:*",
    "@ionic/pwa-elements": "^3.2.0",
    "@ionic/react": "^8.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/cli": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@feature-sliced/steiger-plugin": "^0.5.0",
    "@types/bun": "^1.2.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "steiger": "^0.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-pwa": "^1.0.0"
  }
}
